#!/usr/bin/env python3
"""hq-trends: waar praten mensen de afgelopen weken over? (last30days, alleen open API's)

Gebruik:
  hq-trends "cookiebanner scanner"                         Hacker News, GitHub en Polymarket
  hq-trends "puzzelgames browser" --dagen 14
  hq-trends "ai act chatbot" --bronnen hackernews,github

Bewust alleen bronnen met een open, officiële API. Reddit, X, TikTok, Instagram en YouTube staan uit:
die mogen volgens hun voorwaarden niet zo uitgelezen worden, en omwegen om blokkades heen doen we niet
(skill `geld-en-regels`). Zoek je breder? Gebruik je eigen WebSearch en `hq-web`.
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys

ALLOWED = ("hackernews", "github", "polymarket")
# Tips uit last30days die naar bronnen wijzen die wij niet gebruiken (scrapers, cookies, yt-dlp).
NOISE = re.compile(r"ScrapeCreators|yt-dlp|unlock|Free fixes|Bonus:|BRAVE_API_KEY|SERPER_API_KEY|Missing:|YouTube:|TikTok|Instagram", re.I)
ANSI = re.compile(r"\x1b\[[0-9;]*m")


def stop(msg: str, code: int = 2) -> None:
    print(f"hq-trends: {msg}", file=sys.stderr)
    sys.exit(code)


def engine() -> str:
    base = os.environ.get("HQ_LAST30DAYS_DIR", os.path.expanduser("~/tools/last30days"))
    script = os.path.join(base, "skills", "last30days", "scripts", "last30days.py")
    if not os.path.exists(script):
        stop("last30days is niet geïnstalleerd; zie onderneming/deploy/setup-vps.sh", 3)
    return script


def python312() -> str:
    for name in ("python3", "python3.13", "python3.12"):
        path = shutil.which(name)
        if not path:
            continue
        out = subprocess.run([path, "-c", "import sys; print(sys.version_info >= (3, 12))"], capture_output=True, text=True)
        if out.stdout.strip() == "True":
            return path
    stop("last30days heeft Python 3.12 of nieuwer nodig", 3)
    return ""


def main() -> None:
    ap = argparse.ArgumentParser(prog="hq-trends", description="Recente discussies over een onderwerp.")
    ap.add_argument("onderwerp", nargs="+")
    ap.add_argument("--dagen", type=int, default=30)
    ap.add_argument("--bronnen", default=",".join(ALLOWED))
    args = ap.parse_args()

    sources = [s.strip().lower() for s in args.bronnen.split(",") if s.strip()]
    bad = [s for s in sources if s not in ALLOWED]
    if bad:
        stop(f"bron(nen) {', '.join(bad)} niet toegestaan; kies uit {', '.join(ALLOWED)}")
    days = min(max(args.dagen, 1), 30)
    cmd = [
        python312(), engine(), " ".join(args.onderwerp),
        "--quick", "--emit=compact", "--search", ",".join(sources), "--days", str(days),
        "--web-backend", "none", "--no-browser-cookies",
    ]
    env = {k: v for k, v in os.environ.items() if k not in ("FROM_BROWSER", "SCRAPECREATORS_API_KEY")}
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=180, env=env)
    except subprocess.TimeoutExpired:
        stop("duurde te lang (3 minuten); probeer een specifieker onderwerp", 5)
    lines = [ANSI.sub("", line) for line in res.stdout.splitlines()]
    out = "\n".join(line for line in lines if not NOISE.search(line)).strip()
    if res.returncode != 0 or not out:
        tail = " | ".join(res.stderr.strip().splitlines()[-2:])[:400]
        stop(f"geen resultaat{': ' + tail if tail else ''}", 5)
    print(out)


if __name__ == "__main__":
    main()
