# Gratis AI-router (OmniRoute). Op de server: ~/.config/hq/gratis-ai.env (chmod 600).
#
# Eén sleutel per aanbieder, van je eigen account, binnen hun gratis laag. Die maak je zelf aan; vul in wat je
# hebt, leeg laten mag. Meer aanbieders = langer doorwerken als er één vol zit. Na wijzigen:
#   cd ~/KK-Kalle/onderneming/hq
#   node --env-file=$HOME/.config/hq/hq.env dist/main.js gratis-ai --schrijf
#
# Niet doen: abonnementen koppelen (Claude, ChatGPT, Copilot), inloggen met webchat-cookies of meerdere accounts
# per aanbieder. OmniRoute kan het, maar het schendt de voorwaarden van die aanbieders en je account (ook dat van
# Claude Code) kan geblokkeerd worden. HQ zet zulke verbindingen nooit in de combo.

# --- Door setup-vps.sh ingevuld. Niet delen, en STORAGE_ENCRYPTION_KEY nooit veranderen. ---
JWT_SECRET=
API_KEY_SECRET=
STORAGE_ENCRYPTION_KEY=
INITIAL_PASSWORD=
# Wachtwoord van het dashboard; HQ logt hiermee in. Verander je het in het dashboard, zet het dan ook hier.
OMNIROUTE_PASSWORD=

# --- Jouw sleutels ---
# Groq (console.groq.com/keys): snel, limieten per model per minuut en per dag, traint niet op je gegevens.
GROQ_API_KEY=
# Cerebras (cloud.cerebras.ai): dagelijks tokenlimiet, traint niet op je gegevens.
CEREBRAS_API_KEY=
# SambaNova (cloud.sambanova.ai/apis): limieten per minuut en per dag.
SAMBANOVA_API_KEY=
# Google AI Studio (aistudio.google.com/apikey): Gemini Flash. In de EU/EER niet gebruikt voor training.
GEMINI_API_KEY=
# Hugging Face (huggingface.co/settings/tokens, soort "Read"): klein gratis tegoed per maand.
HF_TOKEN=
# Mistral (console.mistral.ai/api-keys): Experiment-plan. Kan je gegevens voor training gebruiken, tenzij je dat uitzet.
MISTRAL_API_KEY=
# OpenRouter (openrouter.ai/keys): alleen de :free-modellen, ~50 verzoeken per dag. Sommige bewaren prompts.
OPENROUTER_API_KEY=
