# Sleutels voor de gratis AI-router. Op de server: ~/.config/hq/gratis-ai.env (chmod 600).
# Eén sleutel per aanbieder, van je eigen account, binnen hun gratis laag. Die maak je zelf aan;
# vul in wat je hebt, leeg laten mag. Meer aanbieders = langer doorwerken als er één vol zit.
#
# Na wijzigen:  cd ~/KK-Kalle/onderneming/hq
#               node --env-file=$HOME/.config/hq/hq.env dist/main.js gratis-ai --schrijf
#               systemctl --user restart gratis-ai

# Wachtwoord van de router zelf. setup-vps.sh vult het in; dezelfde waarde staat als HQ_GRATIS_AI_KEY in hq.env.
LITELLM_MASTER_KEY=

# Groq (console.groq.com/keys): snel, limieten per model per minuut en per dag, traint niet op je gegevens.
GROQ_API_KEY=
# Cerebras (cloud.cerebras.ai): dagelijks tokenlimiet, traint niet op je gegevens.
CEREBRAS_API_KEY=
# Google AI Studio (aistudio.google.com/apikey): Gemini Flash. In de EU/EER niet gebruikt voor training.
GEMINI_API_KEY=
# Mistral (console.mistral.ai): Experiment-plan. Kan je gegevens voor training gebruiken, tenzij je dat uitzet.
MISTRAL_API_KEY=
# OpenRouter (openrouter.ai/keys): alleen de :free-modellen, ~50 verzoeken per dag. Sommige bewaren prompts.
OPENROUTER_API_KEY=
