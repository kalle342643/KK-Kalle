# HQ-configuratie. Kopie staat op de server in ~/.config/hq/hq.env (chmod 600).
# Na wijzigen: systemctl --user restart hq

# --- Database -----------------------------------------------------------------
# Lokaal (door setup-vps.sh aangemaakt, inloggen als gebruiker 'ai' via de Unix-socket, zonder wachtwoord):
DATABASE_URL=postgresql://ai@/hq?host=/var/run/postgresql
# Of Supabase (gratis, staat los van je server): Project → Connect → "Session pooler"
# DATABASE_URL=postgresql://postgres.xxxx:WACHTWOORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- HQ zelf ------------------------------------------------------------------
HQ_PORT=8080
# 0.0.0.0 = bereikbaar via Tailscale (de firewall laat alleen Tailscale en SSH toe).
HQ_HOST=0.0.0.0
# Verplicht als HQ_HOST niet 127.0.0.1 is. Het kantoor openen: http://<tailscale-naam>:8080/?token=<dit token>
HQ_ADMIN_TOKEN=
# Adres waarop de agents (op deze server) HQ bereiken.
HQ_AGENT_URL=http://127.0.0.1:8080
HQ_TIMEZONE=Europe/Amsterdam

# --- Paperclip ----------------------------------------------------------------
# Het adres dat `paperclipai onboard` toonde + /api. Met 'bind tailnet' is dat je Tailscale-naam,
# bv. http://ubuntu-4gb-fsn1-1:3100/api (127.0.0.1 werkt dan niet).
PAPERCLIP_API_URL=http://127.0.0.1:3100/api
# Board-sleutel: paperclipai token board create --name hq --never-expires
PAPERCLIP_BOARD_TOKEN=
# Leeg laten: `hq bootstrap` maakt het bedrijf aan en onthoudt het id.
PAPERCLIP_COMPANY_ID=

# --- Telegram (aanbevolen) ----------------------------------------------------
# Maak een bot via @BotFather en plak het token hier. Start HQ, stuur /start naar je bot:
# hij antwoordt met je chat-id. Vul die hieronder in en herstart HQ.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# --- WhatsApp (optioneel, alleen meldingen) -------------------------------------
# Vereist een geverifieerd Meta Business-account en een goedgekeurd sjabloon met één variabele {{1}}.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TO=316xxxxxxxx
# WHATSAPP_TEMPLATE=hq_update
# WHATSAPP_TEMPLATE_LANG=nl

# --- Kennisbank en Graphify -----------------------------------------------------
# Map met alles wat agents leerden als Markdown-notities (HQ werkt hem elk uur bij). Open hem gerust in Obsidian.
HQ_VAULT_DIR=/home/ai/vault
# Graphify (door setup-vps.sh geïnstalleerd met pipx) maakt er 's nachts een kennisgraaf van.
GRAPHIFY_BIN=/home/ai/.local/bin/graphify
# Een aparte Anthropic-sleutel alleen voor Graphify, met een eigen lage limiet (bv. $5 per maand).
# Leeg laten = geen AI-extractie; HQ bouwt dan zelf een eenvoudigere graaf uit lessen, notities en experimenten.
# Of gratis: GRAPHIFY_BACKEND=gratis (via de gratis AI-router hieronder, dan is GRAPHIFY_API_KEY niet nodig).
GRAPHIFY_API_KEY=
GRAPHIFY_BACKEND=claude
# Pas vanaf zoveel lessen en notities bouwt Graphify met AI een graaf en krijgen agents graaf-uitvoer.
# Daaronder vindt gewoon zoeken hetzelfde (docs/ONDERZOEK-AGENTS.md). Het hologram werkt altijd.
HQ_GRAPHIFY_MIN_NOTES=100
GRAPHIFY_MODEL=claude-haiku-4-5

# --- Werkplaats: je projecten en Claude Code in het kantoor -------------------------
# Een fine-grained GitHub-token, alleen lezen, voor de repositories die je wilt volgen
# (github.com → Settings → Developer settings → Fine-grained tokens). Rechten (Repository permissions):
# Contents, Metadata, Pull requests, Commit statuses, Deployments en Actions: allemaal "Read-only".
# Leeg = de werkplaats controleert alleen of je sites bereikbaar zijn.
HQ_GITHUB_TOKEN=
HQ_GITHUB_POLL_SECONDS=120
HQ_HEALTH_CHECK_SECONDS=300
# Hoe jij heet in backlogs ("dit ligt bij Kalle"): die punten staan in het kantoor bij jou.
HQ_OWNER_NAMES=Kalle
# Geheim voor live meldingen van Claude Code (hooks). setup-vps.sh vult het in. Kan alleen meldingen
# sturen, niets lezen. Zie docs/SETUP.md, "Claude Code live in het kantoor".
HQ_HOOK_TOKEN=

# --- Gratis AI (OmniRoute op deze server) -----------------------------------------------
# Sleutel van HQ bij OmniRoute. `dist/main.js gratis-ai --schrijf` maakt hem en zet hem hier.
# Leeg = gratis AI staat uit. De sleutels van de aanbieders staan in ~/.config/hq/gratis-ai.env.
HQ_GRATIS_AI_KEY=
HQ_GRATIS_AI_URL=http://127.0.0.1:20128
# Welke agents op gratis AI draaien (sjablonen, komma-gescheiden). Begin klein, bv. alleen verkenner.
# Let op: gratis modellen zijn minder slim dan Claude en kunnen niet zelf zoeken (WebSearch);
# ze gebruiken dan hq-web en hq-trends. Na wijzigen: dist/main.js bootstrap
HQ_GRATIS_AI_ROLES=
# Graphify kan de kennisgraaf ook via de router bouwen: zet dan hierboven GRAPHIFY_BACKEND=gratis.

# --- Omzet-imports --------------------------------------------------------------
# Stripe: maak een "restricted key" met alleen leesrechten op Charges.
# STRIPE_API_KEY=rk_live_...
# STRIPE_DEFAULT_BRANCH=games

# --- Geldregels ------------------------------------------------------------------
# Omrekenkoers van Paperclip-kosten (dollar) naar euro. Bijwerken als de koers flink verschuift.
HQ_USD_TO_EUR=0.9
# Totaal AI-plafond per maand (harde stop in Paperclip), bovenop 30% van de omzet.
HQ_GLOBAL_MONTHLY_CAP_EUR=40
HQ_EXPERIMENT_BUDGET_EUR=20
HQ_EXPERIMENT_MAX_BUDGET_EUR=50
HQ_EXPERIMENT_MAX_DAYS=14
HQ_REVENUE_SHARE_FOR_AI=0.3
# Kost een dag meer dan dit, dan gaat alles automatisch op noodstop.
HQ_DAILY_SPEND_ALARM_EUR=15
HQ_MAX_REQUESTS_PER_AGENT_PER_DAY=5
HQ_MAX_ITERATIONS=2

# --- Planning (cron, in HQ_TIMEZONE; aanhalingstekens laten staan) -----------------
HQ_DAILY_REPORT_CRON="0 8 * * *"
HQ_WEEKLY_PORTFOLIO_CRON="30 7 * * 1"
HQ_EVALUATE_CRON="0 7 * * *"
HQ_SYNC_CRON="*/2 * * * *"
HQ_COST_SYNC_CRON="*/15 * * * *"
HQ_REVENUE_IMPORT_CRON="0 * * * *"
HQ_VAULT_SYNC_CRON="20 * * * *"
HQ_KNOWLEDGE_CRON="30 3 * * *"
